# Banco de dados Postgres (Supabase). Pegue no Supabase em:
# Connect > Direct (aba "Connection string") > Session pooler (funciona em IPv4, de graça)
DATABASE_URL="postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

JWT_SECRET="troque-isso-por-um-segredo-bem-grande-e-aleatorio"
PORT=3333

# URL do frontend, usada no CORS
CLIENT_URL="http://localhost:5173"

# Supabase Storage — pra guardar avatar, banner e imagens de post permanentemente.
# SUPABASE_URL: Project Settings > General > Project URL
# SUPABASE_SERVICE_ROLE_KEY: Project Settings > API Keys > service_role (NUNCA exponha essa chave no frontend)
SUPABASE_URL="https://SEU_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
SUPABASE_STORAGE_BUCKET="uploads"

# Push notifications (opcional). Gere um par com:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seu-email@example.com"
